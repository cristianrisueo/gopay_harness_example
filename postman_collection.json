				{
					"name": "Deposit",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{$guid}}",
								"description": "Required. A new UUID per deposit or withdrawal intent, shared by deposits and withdrawals of the user. {{$guid}} generates a new one on every send; to test a retry, replace it with a fixed UUID and send the request twice."
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": \"2000.00\",\n  \"currency\": \"USD\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/wallet/deposit",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"wallet",
								"deposit"
							]
						},
						"description": "Deposit funds to wallet (EUR, USD, or JPY). Amount: positive, at most 4 decimals and at most 999999999999999.9999. Requires the Idempotency-Key header: the app must reuse the same key in every retry of the same deposit. A retry with a used key and the same operation, amount and currency returns 200 with header Idempotent-Replayed: true and the current wallet, and moves no money; with different data it returns 422 IDEMPOTENCY_KEY_REUSED. Missing or invalid key: 400. Breaking change: the Idempotency-Key header is now mandatory (requests without it get 400), and amounts with more than 4 decimals or above the maximum now get 400 instead of being rounded."
					},
					"response": []
				},
				{
					"name": "Withdraw",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{$guid}}",
								"description": "Required. A new UUID per deposit or withdrawal intent, shared by deposits and withdrawals of the user. {{$guid}} generates a new one on every send; to test a retry, replace it with a fixed UUID and send the request twice."
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": \"100.00\",\n  \"currency\": \"EUR\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/wallet/withdraw",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"wallet",
								"withdraw"
							]
						},
						"description": "Withdraw funds from wallet (requires sufficient balance). Amount: positive, at most 4 decimals and at most 999999999999999.9999. Requires the Idempotency-Key header: the app must reuse the same key in every retry of the same withdrawal. A retry with a used key and the same operation, amount and currency returns 200 with header Idempotent-Replayed: true and the current wallet, and moves no money, even if the balance no longer covers it; with different data it returns 422 IDEMPOTENCY_KEY_REUSED. Missing or invalid key: 400. Breaking change: the Idempotency-Key header is now mandatory (requests without it get 400), and amounts with more than 4 decimals or above the maximum now get 400 instead of being rounded."
					},
					"response": []
				}
			]
		},
