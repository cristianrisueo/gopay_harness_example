# Server Configuration
PORT=8080
ENV=development

# Database Configuration
POSTGRES_DB=gopay
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_DSN=postgres://admin:password@localhost/gopay?sslmode=disable

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=debug

# LLM model
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL=gpt-4o