{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(make *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go mod *)",
      "Bash(gofmt *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git cat-file *)",
      "Bash(git ls-tree *)",
      "Bash(git ls-remote *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git mv *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(gh label create *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(docker compose *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker exec *)",
      "Bash(curl *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/Makefile)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git reset --hard*)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(make reset-db*)",
      "Bash(make migrate-down*)"
    ]
  },
  "showClearContextOnPlanAccept": true,
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "gh *",
      "git *",
      "make test-integration",
      "docker compose *",
      "docker ps *",
      "docker logs *",
      "docker exec *"
    ],
    "filesystem": {
      "allowWrite": [
        "./.git",
        "~/Library/Caches/go-build",
        "~/.cache/go-build",
        "~/go/pkg/mod"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": ["localhost", "127.0.0.1"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-tests.sh"
          }
        ]
      }
    ]
  }
}
